{
  "name": "VEEP-N VPN Console",
  "short_name": "VEEP-N",
  "id": "/",
  "description": "Installable VPN bridge console for relay discovery, desktop handoff, and OpenVPN profiles.",
  "start_url": "/",
  "scope": "/",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "display": "standalone",
  "background_color": "#07111f",
  "theme_color": "#08111f",
  "icons": [
    {
      "src": "/veepn-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/veepn-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/veepn-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/veepn-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "categories": ["utilities", "security", "productivity"],
  "prefer_related_applications": false
}
